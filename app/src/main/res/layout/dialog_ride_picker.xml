<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textAllCaps="true"
        android:textColor="@color/blue_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/share_ride_message"
        android:textColor="@color/blue_dark"
        android:textSize="14sp"
        android:textStyle="italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/passenger_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:text="@string/passengers"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:textSize="15sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/passenger_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="3"
            app:labelBehavior="gone"
            app:thumbColor="@color/blue_dark"
            app:thumbHeight="25dp"
            app:tickColor="@color/blue_dark"
            app:tickVisible="true"
            app:trackColorActive="@color/blue_dark" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/baggage_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:text="@string/baggage"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:textSize="15sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/baggage_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="1"
            android:valueTo="3"
            app:labelBehavior="gone"
            app:thumbColor="@color/blue_dark"
            app:thumbHeight="25dp"
            app:tickColor="@color/blue_dark"
            app:tickVisible="true"
            app:trackColorActive="@color/blue_dark" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/locationPickerOrigin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/location_Origin"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="@string/set_origin"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:textSize="15sp" />

        <ImageButton
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:contentDescription="@string/location_picker"
            android:focusable="false"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/add_location" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/locationPickerDestination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:background="@drawable/input_bg"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/location_Destination"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="@string/set_destination"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:textSize="15sp" />

        <ImageButton
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:contentDescription="@string/location_picker"
            android:focusable="false"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/add_location" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_Cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/box_white_red"
            android:text="@string/cancel"
            android:textColor="@color/red"
            android:textSize="15sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/box_blue_dark"
            android:text="@string/book"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="@null" />

    </LinearLayout>

</LinearLayout>